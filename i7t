<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChefHands - Touchless Recipe Overlay</title>
    <!-- Import MediaPipe via CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.0"></script>
    <style>
        :root {
            --primary: #e67e22;
            --bg: #fafafa;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            background: var(--bg);
            color: #333;
            overflow-x: hidden;
        }

        /* The Recipe Overlay Content */
        #recipe-container {
            padding: 20px;
            max-width: 800px;
            margin: auto;
            line-height: 1.6;
            transition: all 0.5s ease;
        }

        .step {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border-left: 5px solid var(--primary);
        }

        /* Floating Camera UI */
        #camera-wrapper {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 200px;
            height: 150px;
            border-radius: 15px;
            overflow: hidden;
            border: 3px solid var(--primary);
            background: #000;
            z-index: 1000;
        }
        #webcam {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transform: rotateY(180deg);
        }

        /* Status & Feedback */
        #status-bar {
            position: fixed;
            top: 0;
            width: 100%;
            background: var(--primary);
            color: white;
            text-align: center;
            padding: 10px;
            font-weight: bold;
            z-index: 1001;
        }
        #gesture-indicator {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 80px;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 2000;
        }
    </style>
</head>
<body>

<div id="status-bar">Loading Kitchen AI Hand Sensors...</div>

<div id="gesture-indicator">👍</div>

<div id="recipe-container">
    <h1 id="recipe-title">Loading Recipe...</h1>
    <div id="steps-list"></div>
    <!-- Extra space to allow scrolling -->
    <div style="height: 600px;"></div>
</div>

<div id="camera-wrapper">
    <video id="webcam" autoplay playsinline></video>
</div>

<script type="module">
    import { GestureRecognizer, FilesetResolver } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.0";

    const recipeData = [
        {
            title: "Garlic Butter Pasta",
            steps: [
                "Boil a large pot of salted water.",
                "Mince 4 cloves of garlic while pasta cooks.",
                "In a pan, melt 3 tbsp butter over medium heat.",
                "Add garlic and red pepper flakes; sauté until fragrant.",
                "Toss pasta in garlic butter with 1/4 cup pasta water.",
                "Top with parsley and parmesan cheese."
            ]
        },
        {
            title: "Quick Avocado Toast",
            steps: [
                "Toast two slices of sourdough bread.",
                "Mash one ripe avocado with salt, pepper, and lemon juice.",
                "Spread evenly over the warm toast.",
                "Optional: Top with a poached egg or chili oil."
            ]
        }
    ];

    let currentRecipeIdx = 0;
    let gestureRecognizer;
    let webcamRunning = false;
    const video = document.getElementById("webcam");
    const status = document.getElementById("status-bar");
    const indicator = document.getElementById("gesture-indicator");

    // Load the MediaPipe Model
    async function initModel() {
        const vision = await FilesetResolver.forVisionTasks("https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.0/wasm");
        gestureRecognizer = await GestureRecognizer.createFromOptions(vision, {
            baseOptions: {
                modelAssetPath: "https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/1/gesture_recognizer.task",
                delegate: "GPU"
            },
            runningMode: "VIDEO"
        });
        status.innerText = "AI Ready: Use Gestures (👍, 👎, ✋, ✌️)";
        startCamera();
    }

    async function startCamera() {
        const constraints = { video: true };
        navigator.mediaDevices.getUserMedia(constraints).then((stream) => {
            video.srcObject = stream;
            video.addEventListener("loadeddata", predictWebcam);
        });
    }

    function renderRecipe() {
        const recipe = recipeData[currentRecipeIdx];
        document.getElementById("recipe-title").innerText = recipe.title;
        const list = document.getElementById("steps-list");
        list.innerHTML = recipe.steps.map((step, i) => `
            <div class="step">
                <h3>Step ${i + 1}</h3>
                <p>${step}</p>
            </div>
        `).join('');
    }

    let lastVideoTime = -1;
    async function predictWebcam() {
        let nowInMs = Date.now();
        if (video.currentTime !== lastVideoTime) {
            lastVideoTime = video.currentTime;
            const results = gestureRecognizer.recognizeForVideo(video, nowInMs);

            if (results.gestures.length > 0) {
                const gesture = results.gestures[0][0].categoryName;
                handleGesture(gesture);
            }
        }
        window.requestAnimationFrame(predictWebcam);
    }

    let isCooldown = false;
    function handleGesture(name) {
        if (isCooldown) return;

        if (name === "Thumb_Up") {
            window.scrollBy({ top: 150, behavior: 'smooth' });
            showIndicator("👍");
            triggerCooldown(500);
        } 
        else if (name === "Thumb_Down") {
            window.scrollBy({ top: -150, behavior: 'smooth' });
            showIndicator("👎");
            triggerCooldown(500);
        }
        else if (name === "Victory") { // ✌️
            currentRecipeIdx = (currentRecipeIdx + 1) % recipeData.length;
            renderRecipe();
            window.scrollTo({top: 0, behavior: 'smooth'});
            showIndicator("✌️ Next Recipe");
            triggerCooldown(2000);
        }
        else if (name === "Open_Palm") {
            showIndicator("✋");
        }
    }

    function showIndicator(emoji) {
        indicator.innerText = emoji;
        indicator.style.opacity = "1";
        setTimeout(() => indicator.style.opacity = "0", 600);
    }

    function triggerCooldown(ms) {
        isCooldown = true;
        setTimeout(() => isCooldown = false, ms);
    }

    renderRecipe();
    initModel();
</script>

</body>
</html>
